{
  "name": "hyperfocus-health",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for Hyperfocus Health: adult ADHD assessment and care by video for Queensland adults.",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "contrast": "node scripts/check-contrast.ts",
    "shots": "node scripts/screenshots.mjs",
    "kb": "UPDATE_KB=1 vitest run tests/unit/knowledge-base.test.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
