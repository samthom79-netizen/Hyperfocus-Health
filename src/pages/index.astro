---
/**
 * Homepage. All words live in src/content/home.md; prices and the
 * 'not suitable' list come from src/config/site.ts.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import CtaLabel from '../components/CtaLabel.astro';
import Icon from '../components/Icon.astro';
import ShortVersion from '../components/ShortVersion.astro';
import StepList from '../components/StepList.astro';
import Card from '../components/Card.astro';
import DoctorCard from '../components/DoctorCard.astro';
import Accordion from '../components/Accordion.astro';
import { site, formatPrice, isTodo } from '../config/site';
import { renderTokens } from '../lib/tokens';

const entry = await getEntry('home', 'home');
if (!entry) throw new Error('src/content/home.md is missing');
const c = entry.data;

const trustIcons = ['stethoscope', 'shield', 'map-pin', 'check'] as const;
const cardIcons = ['user', 'mic', 'layers'] as const;
const faqItems = c.faq.items.map((i) => ({ question: i.question, answer: `<p>${renderTokens(i.answer)}</p>` }));
const price = site.prices.assessmentTotal;

const textLink = 'inline-flex min-h-11 items-center gap-1.5 font-bold';
---

<Base title={c.title} description={c.description} flushFooter>
  <!-- 1. HERO -->
  <section aria-labelledby="hero-heading" class="border-b border-line bg-surface">
    <Container class="grid items-center gap-10 py-10 sm:py-14 lg:grid-cols-[1fr_auto] lg:gap-16">
      <div>
        <h1 id="hero-heading">{c.hero.heading}</h1>
        <p class="mt-4 text-[1.15rem]">{c.hero.sub}</p>
        <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-6">
          <Button href={site.cta.href} arrow data-cta="hero"><CtaLabel /></Button>
          <a href={c.hero.secondaryLink.href} class={textLink}>
            {c.hero.secondaryLink.label}
            <Icon name="arrow-right" size={20} />
          </a>
        </div>
        <ul class="mt-8 grid grid-cols-1 gap-x-6 gap-y-3 min-[480px]:grid-cols-2" aria-label="At a glance">
          {
            c.hero.trust.map((item, i) => (
              <li class="flex items-center gap-2.5 text-[0.95rem] font-bold text-primary">
                <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent-ink">
                  <Icon name={trustIcons[i]} size={20} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <DoctorCard layout="hero" eager headingLevel={2} class="justify-self-center lg:justify-self-end" />
    </Container>
  </section>

  <!-- 2. SHORT VERSION -->
  <Container class="pt-10">
    <ShortVersion bullets={c.shortVersion} />
  </Container>

  <!-- 3. HOW IT WORKS -->
  <Container as="section" class="pt-14" aria-labelledby="how-heading">
    <h2 id="how-heading">{c.howItWorks.heading}</h2>
    <div class="mt-6 rounded-card border border-line bg-surface p-5 sm:p-7">
      <StepList steps={c.howItWorks.steps} />
    </div>
    <p class="mt-4">
      <a href={c.howItWorks.link.href} class={textLink}>{c.howItWorks.link.label} <Icon name="arrow-right" size={20} /></a>
    </p>
  </Container>

  <!-- 4. WHY IT'S DIFFERENT -->
  <Container as="section" class="pt-14" aria-labelledby="different-heading">
    <h2 id="different-heading">{c.different.heading}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {
        c.different.cards.map((card, i) => (
          <Card title={card.title}>
            <Icon name={cardIcons[i]} slot="icon" />
            <p>{card.body}</p>
          </Card>
        ))
      }
    </div>
  </Container>

  <!-- 5. MEET DR SAM + 6. PRICING TEASER -->
  <Container class="grid gap-6 pt-14 md:grid-cols-2">
    <section aria-labelledby="meet-heading" class="rounded-card border border-line bg-surface p-5 sm:p-7">
      <h2 id="meet-heading">{c.meetDrSam.heading}</h2>
      <ul class="mt-4 space-y-2">
        {c.meetDrSam.lines.map((line) => <li>{line}</li>)}
      </ul>
      <p class="mt-3">
        <a href={c.meetDrSam.link.href} class={textLink}>{c.meetDrSam.link.label} <Icon name="arrow-right" size={20} /></a>
      </p>
    </section>

    <section aria-labelledby="price-heading" class="rounded-card border-2 border-primary bg-surface p-5 sm:p-7">
      <h2 id="price-heading">{c.pricing.heading}</h2>
      <p class="mt-4 flex flex-wrap items-baseline gap-x-2">
        {
          isTodo(price) ? (
            <span class="todo text-[1.4rem]">[{price}]</span>
          ) : (
            <span class="font-display text-[2.2rem] leading-none font-extrabold text-primary">{formatPrice(price)}</span>
          )
        }
        <span class="text-ink-muted">{c.pricing.totalLabel}</span>
      </p>
      <p class="mt-3">{c.pricing.includes}</p>
      <p class="mt-2">{c.pricing.medicare}</p>
      <p class="mt-3">
        <a href={c.pricing.link.href} class={textLink}>{c.pricing.link.label} <Icon name="arrow-right" size={20} /></a>
      </p>
    </section>
  </Container>

  <!-- 7. IS THIS FOR YOU? -->
  <Container as="section" class="pt-14" aria-labelledby="fit-heading">
    <h2 id="fit-heading">{c.fit.heading}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-card border border-line bg-surface p-5 sm:p-7">
        <h3 class="text-[1.15rem] font-bold">{c.fit.goodHeading}</h3>
        <ul class="mt-4 space-y-2.5">
          {
            c.fit.good.map((item) => (
              <li class="flex gap-2.5">
                <Icon name="check" size={22} class="mt-0.5 text-accent-ink" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-card border border-line bg-surface p-5 sm:p-7">
        <h3 class="text-[1.15rem] font-bold">{c.fit.elsewhereHeading}</h3>
        <ul class="mt-4 list-disc space-y-1.5 pl-5 marker:text-ink-muted" data-not-suitable>
          {site.notSuitable.map((item) => <li>{item}</li>)}
        </ul>
        <p class="mt-4">{c.fit.elsewhereIntro}</p>
        <p class="mt-2">
          <a href={c.fit.elsewhereLink.href} class={textLink}>{c.fit.elsewhereLink.label} <Icon name="arrow-right" size={20} /></a>
        </p>
      </div>
    </div>
  </Container>

  <!-- 8. FAQ -->
  <Container as="section" class="pt-14" aria-labelledby="faq-heading">
    <h2 id="faq-heading">{c.faq.heading}</h2>
    <Accordion items={faqItems} class="mt-6" />
    <p class="mt-4">
      <a href={c.faq.link.href} class={textLink}>{c.faq.link.label} <Icon name="arrow-right" size={20} /></a>
    </p>
  </Container>

  <!-- 9. FINAL CTA -->
  <section aria-labelledby="final-heading" class="on-dark mt-16 bg-primary text-white">
    <Container class="flex flex-col items-start gap-5 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 id="final-heading" class="text-white">{c.finalCta.heading}</h2>
        <p class="mt-2 text-[1.1rem] text-white">{c.finalCta.body}</p>
      </div>
      <Button href={site.cta.href} variant="inverse" arrow class="shrink-0" data-cta="final"><CtaLabel /></Button>
    </Container>
  </section>
</Base>
