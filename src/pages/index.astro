---
/**
 * Placeholder homepage. Prompt 3 builds the real one from src/content/home.md.
 */
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import CtaLabel from '../components/CtaLabel.astro';
import { site } from '../config/site';
---

<Base title={site.name} description={site.tagline}>
  <Container class="py-12">
    <h1>{site.tagline}</h1>
    <p class="mt-4 text-[1.1rem]">
      One doctor who has ADHD himself, from your first appointment to ongoing care. The full cost is shown upfront.
    </p>
    <p class="mt-8">
      <Button href={site.cta.href} arrow><CtaLabel /></Button>
    </p>
    <p class="mt-10 text-[0.9rem] text-ink-muted">Site under construction.</p>
  </Container>
</Base>
