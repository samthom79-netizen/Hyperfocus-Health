---
/**
 * Where people who aren't suitable for this service can go instead.
 * Words live in src/content/other-options.md. Kind, no blame, no booking button.
 */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import ShortVersion from '../components/ShortVersion.astro';
import CrisisStrip from '../components/CrisisStrip.astro';
import Icon from '../components/Icon.astro';

const entry = await getEntry('pages', 'other-options');
if (!entry) throw new Error('src/content/other-options.md is missing');
const { Content } = await render(entry);
const { title, description, heading, readingTime, shortVersion } = entry.data;
---

<Base title={title} description={description}>
  <Container class="py-10 sm:py-14">
    <div class="max-w-3xl">
      <h1>{heading ?? title}</h1>
      {shortVersion && <ShortVersion bullets={shortVersion} readingTime={readingTime} class="mt-6" />}
      <div class="prose-hf mt-8">
        <Content />
      </div>
      <CrisisStrip variant="full" class="mt-10" />
      <p class="mt-8">
        <a href="/" class="inline-flex min-h-11 items-center gap-1.5 font-bold">
          Back to the homepage <Icon name="arrow-right" size={20} />
        </a>
      </p>
    </div>
  </Container>
</Base>
