---
/**
 * /book: the two ways to see Dr Sam, then the booking step.
 * Words: src/content/book.md. Prices and booking settings: src/config/site.ts.
 */
import MarkdownPage from '../layouts/MarkdownPage.astro';
import PriceCard from '../components/PriceCard.astro';
import BookingPanel from '../components/BookingPanel.astro';
import Callout from '../components/Callout.astro';
import Icon from '../components/Icon.astro';
import InPersonBooking from '../components/InPersonBooking.astro';
import { formatPrice, site } from '../config/site';

const { clinic } = site;
---

<MarkdownPage slug="book">
  <div slot="before">
    <p class="mt-6">
      Haven't done the 60-second check?
      <a href={site.cta.href} class="inline-flex min-h-11 items-center gap-1.5 font-bold">
        Do that first <Icon name="arrow-right" size={20} />
      </a>
    </p>

    <PriceCard
      title="Telehealth assessment"
      price={site.prices.assessmentTotal}
      priceLabel="total for the full assessment"
      includes={[
        'Video or phone, anywhere in Queensland',
        'Online intake on your phone, reviewed by Dr Sam',
        `Appointment 1 (about ${site.appointments.assessment} min)`,
        `Appointment 2 (about ${site.appointments.diagnosis.min}-${site.appointments.diagnosis.max} min)`,
        'Your written plan',
      ]}
      note={`Paid in 3 parts: ${formatPrice(site.prices.intakeReview)} now for the intake review, ${formatPrice(site.prices.payAppointment1)} when you're invited to book appointment 1, and ${formatPrice(site.prices.payAppointment2)} for appointment 2. No Medicare rebate for new patients. ${site.appointments.lengthsNote}`}
      featured
      class="mt-6"
    />

    <div class="mt-5">
      <BookingPanel />
    </div>

    <Callout class="mt-5" title="You book appointment 1 after Dr Sam has read your intake">
      <p>He emails you an invitation to book, a request for anything else he needs first (such as a test), or an explanation if this service isn't right for you.</p>
    </Callout>

    <h2 class="mt-10">Would you rather come in?</h2>
    <p class="mt-3">Only if you can get to {clinic.suburb}, in the Whitsundays. Everything else is the same.</p>
    <PriceCard
      title={`In person at ${clinic.suburb}`}
      price={site.prices.assessmentTotal}
      priceLabel="total, same as video or phone"
      includes={['Medicare rebate may apply', `${clinic.name}, ${clinic.street}, ${clinic.suburb} ${clinic.state} ${clinic.postcode}`]}
      note={`${site.booking.inPerson.feeNote} Booked through the clinic, not online here.`}
      class="mt-5"
    >
      <InPersonBooking />
    </PriceCard>
  </div>
</MarkdownPage>
