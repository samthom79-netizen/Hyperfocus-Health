---
/**
 * /book: the two ways to see Dr Sam, then the booking step.
 * Words: src/content/book.md. Prices and booking settings: src/config/site.ts.
 */
import MarkdownPage from '../layouts/MarkdownPage.astro';
import PriceCard from '../components/PriceCard.astro';
import BookingPanel from '../components/BookingPanel.astro';
import Callout from '../components/Callout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';

const { clinic } = site;
---

<MarkdownPage slug="book">
  <div slot="before">
    <p class="mt-6">
      Haven't done the 60-second check?
      <a href={site.cta.href} class="inline-flex min-h-11 items-center gap-1.5 font-bold">
        Do that first <Icon name="arrow-right" size={20} />
      </a>
    </p>

    <div class="mt-6 grid gap-5 md:grid-cols-2">
      <PriceCard
        title="Telehealth assessment"
        price={site.prices.assessmentTotal}
        priceLabel="total to reach a diagnosis"
        includes={[
          'Video, anywhere in Queensland',
          'Online intake on your phone',
          `Video appointment 1 (about ${site.appointments.assessment} min)`,
          `Video appointment 2 (about ${site.appointments.diagnosis.min}-${site.appointments.diagnosis.max} min)`,
          'Your written plan',
        ]}
        note="No Medicare rebate for video appointments."
        featured
      />
      <PriceCard
        title={`In person at ${clinic.suburb}`}
        price={site.prices.assessmentTotal}
        priceLabel="total, same as video"
        includes={['Medicare rebate may apply', `${clinic.name}, ${clinic.street}, ${clinic.suburb} ${clinic.state} ${clinic.postcode}`]}
        note={`${site.booking.inPerson.feeNote} Booked through the clinic, not online here.`}
      >
        <div class="mt-4 rounded-xl bg-accent-soft p-4" data-in-person>
          <p class="font-bold text-primary">To book, {site.booking.inPerson.sayWhenBooking}:</p>
          <ul class="mt-2 space-y-1">
            <li>
              <a href={site.booking.inPerson.hotdocUrl} rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 font-bold">
                Book online with HotDoc <Icon name="arrow-right" size={20} />
              </a>
            </li>
            <li>
              <a href={clinic.tel} class="inline-flex min-h-11 items-center gap-1.5 font-bold">
                <Icon name="phone" size={20} /> Call {clinic.name}: {clinic.phone}
              </a>
            </li>
          </ul>
        </div>
      </PriceCard>
    </div>
    <p class="mt-4 text-ink-muted" data-lengths-note>{site.appointments.lengthsNote}</p>

    <Callout class="mt-6" title={`Your first video appointment will be at least ${site.booking.minLeadDays} days away`}>
      <p>That gives you time to finish the intake and baseline checks.</p>
    </Callout>

    <div class="mt-6">
      <BookingPanel />
    </div>
  </div>
</MarkdownPage>
