---
/**
 * /contact. Words: src/content/contact.md. Phone, email and receptionist
 * settings: src/config/site.ts. The phone is answered by an AI receptionist
 * (FAQ and messages only; instructions in docs/receptionist/).
 */
import MarkdownPage from '../layouts/MarkdownPage.astro';
import CrisisStrip from '../components/CrisisStrip.astro';
import AssistantLauncher from '../components/AssistantLauncher.astro';
import Icon from '../components/Icon.astro';
import Val from '../components/Val.astro';
import { isTodo, site } from '../config/site';

const { phone, email } = site.contact;
const tel = isTodo(phone) ? '' : `tel:${phone.replace(/[^\d+]/g, '')}`;
const mailto = isTodo(email) ? '' : `mailto:${email}`;
const action =
  'inline-flex min-h-12 items-center gap-2.5 rounded-xl bg-primary px-5 font-display font-bold text-white no-underline hover:bg-primary-hover';
---

<MarkdownPage slug="contact">
  <div slot="before" class="mt-8 grid gap-5 md:grid-cols-2">
    <section aria-labelledby="phone-heading" class="rounded-card border border-line bg-surface p-5 sm:p-6" data-contact-phone>
      <h2 id="phone-heading" class="text-[1.3rem]">Phone</h2>
      <p class="mt-3">
        {tel ? (
          <a href={tel} class={action}>
            <Icon name="phone" size={22} /> Call {phone}
          </a>
        ) : (
          <Val value={phone} />
        )}
      </p>
      <p class="mt-4" data-receptionist-label>{site.receptionist.label}</p>
      <AssistantLauncher />
    </section>

    <section aria-labelledby="email-heading" class="rounded-card border border-line bg-surface p-5 sm:p-6" data-contact-email>
      <h2 id="email-heading" class="text-[1.3rem]">Email</h2>
      <p class="mt-3">
        {mailto ? (
          <a href={mailto} class={action}>
            <Icon name="mail" size={22} /> {email}
          </a>
        ) : (
          <Val value={email} />
        )}
      </p>
      <p class="mt-4">A person replies within {site.contact.humanReplyWithin}. Complaints get a reply within {site.contact.complaintsReplyWithin}.</p>
    </section>
  </div>

  <CrisisStrip variant="full" class="mt-10" />
</MarkdownPage>
