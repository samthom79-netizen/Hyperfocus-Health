---
/**
 * Page shell used by every page: metadata, structured data, sticky header,
 * main content, footer.
 *
 * SEO (Prompt 9):
 * - Title: '<title> | Hyperfocus Health', or just '<title>' if that would pass 60 characters.
 * - Canonical URL, Open Graph and Twitter tags on every page.
 * - Share image: public/og/<slug>.png (made by `npm run og`), else public/og/default.png.
 * - JSON-LD on every page: MedicalBusiness (the service) and BreadcrumbList.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';
import { site } from '../config/site';
import { businessSchema, breadcrumbSchema, type Crumb } from '../lib/schema';
import { cleanPath, ogSlug } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Keep this page out of search engines (e.g. /styleguide). */
  noindex?: boolean;
  /** Page ends with a dark band: join it to the footer without a gap. */
  flushFooter?: boolean;
  /** Trail between Home and this page, for nested pages. Defaults to Home > this page. */
  crumbs?: Crumb[];
  /** 'article' for resources; 'website' otherwise. */
  ogType?: 'website' | 'article';
}

const { title, description, noindex: pageNoindex = false, flushFooter = false, crumbs, ogType = 'website' } = Astro.props;
// Before launch, every page is hidden from search engines (see site.launched).
const noindex = pageNoindex || !site.launched;
const withBrand = title === site.name ? title : `${title} | ${site.name}`;
const fullTitle = withBrand.length <= 60 ? withBrand : title;

const base = Astro.site ?? new URL(site.url);
// One URL per page, without a trailing slash (matches the sitemap and internal links).
const path = cleanPath(Astro.url.pathname);
const canonical = new URL(path, base).href;

const slug = ogSlug(path);
const ogFile = existsSync(join(process.cwd(), 'public', 'og', `${slug}.png`)) ? `${slug}.png` : 'default.png';
const ogImage = new URL(`/og/${ogFile}`, base).href;

const isHome = path === '/';
const trail: Crumb[] = isHome ? [] : [{ name: 'Home', href: '/' }, ...(crumbs ?? [{ name: title, href: path }])];
const jsonLd = [businessSchema(base), ...(trail.length ? [breadcrumbSchema(trail, base)] : [])];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for AI tools" />
    <meta name="theme-color" content="#08343F" />
    <meta name="color-scheme" content="light" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}: ${site.name}`} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <!-- Page-specific head content, e.g. JSON-LD structured data. -->
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-surface px-4 py-3 font-bold text-primary focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer flush={flushFooter} />
  </body>
</html>
