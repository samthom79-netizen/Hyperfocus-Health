---
/**
 * Emergency and crisis numbers. Required in every footer (compact) and on the
 * eligibility checker's safety screen (full). Numbers are tap-to-call links.
 */
import { site } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  /** compact = 000 + Lifeline + 1300 MH CALL. full = adds Suicide Call Back Service and 13YARN. */
  variant?: 'compact' | 'full';
  /** dark = white text on teal (footer). light = on the page background. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { variant = 'compact', tone = 'light', class: className = '' } = Astro.props;
const lines = variant === 'full' ? site.crisis.lines : site.crisis.lines.slice(0, 2);
const dark = tone === 'dark';
---

<div
  class={`rounded-card p-4 sm:p-5 ${dark ? 'on-dark border border-white/25 text-white' : 'border border-line bg-surface text-ink'} ${className}`}
  role="region"
  aria-label="Emergency and crisis support"
>
  <p class={`flex items-center gap-2 font-display text-[1.05rem] font-extrabold ${dark ? 'text-white' : 'text-primary'}`}>
    <Icon name="phone" size={22} class={dark ? 'text-accent' : 'text-accent-ink'} />
    <a href={site.crisis.emergency.tel} class={`no-underline ${dark ? 'text-white' : 'text-primary'}`}>
      {site.crisis.emergency.label}
    </a>
  </p>
  <ul class="mt-2 flex flex-col gap-x-6 sm:flex-row sm:flex-wrap">
    {
      lines.map((line) => (
        <li>
          <span>{line.label}: </span>
          <a href={line.tel} class={`inline-flex min-h-11 items-center font-bold underline ${dark ? 'text-white' : 'text-primary'}`}>
            {line.number}
          </a>
        </li>
      ))
    }
  </ul>
</div>
