---
/**
 * Button or button-styled link.
 * - primary: dark teal fill, white text (13.35:1). One per screen.
 * - secondary: white fill, teal outline and text.
 * Height is 48px (44px for size="sm"), meeting the 44px tap-target rule.
 */
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'inverse';
  /** 'header' uses fixed pixel sizes so the header always fits a phone screen. */
  size?: 'md' | 'sm' | 'header';
  type?: 'button' | 'submit';
  full?: boolean;
  arrow?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  full = false,
  arrow = false,
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-xl font-display font-bold no-underline text-center transition-colors duration-150 hover:no-underline';
const sizes = {
  md: 'min-h-12 px-5 py-2 text-[1rem]',
  sm: 'min-h-11 px-4 py-2 text-[0.9rem]',
  header: 'min-h-[44px] px-[14px] py-[6px] text-[16px] rounded-[12px]',
};
const variants = {
  primary: 'bg-primary text-white hover:bg-primary-hover',
  secondary: 'bg-surface text-primary border-2 border-primary hover:bg-accent-soft',
  /** For dark (teal) bands: white button, teal text (13.35:1). */
  inverse: 'bg-surface text-primary hover:bg-accent-soft',
};
const classes = [base, sizes[size], variants[variant], full ? 'w-full' : '', className].join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
      {arrow && <Icon name="arrow-right" size={20} />}
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
      {arrow && <Icon name="arrow-right" size={20} />}
    </button>
  )
}
