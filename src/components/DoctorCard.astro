---
/**
 * Dr Sam at a glance: photo, name, title, AHPRA number and a link to /about.
 * The photo is served as AVIF/WebP at 1x and 2x.
 *
 * layout="row"  : small photo (140px) beside the text. Default.
 * layout="hero" : photo on top at up to 280px wide, for the homepage hero.
 */
import { Picture } from 'astro:assets';
import { images } from '../config/images';
import { site } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  layout?: 'row' | 'hero';
  showBio?: boolean;
  showLink?: boolean;
  headingLevel?: 2 | 3;
  /** Load the photo straight away (use for the homepage hero, which is on screen at load). */
  eager?: boolean;
  class?: string;
}

const {
  layout = 'row',
  showBio = false,
  showLink = true,
  headingLevel = 3,
  eager = false,
  class: className = '',
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const { doctor } = site;
const hero = layout === 'hero';
---

<div
  class={`rounded-card border border-line bg-surface p-5 sm:p-6 ${
    hero ? 'flex w-full max-w-[328px] flex-col gap-4' : 'flex flex-col gap-5 sm:flex-row sm:items-start'
  } ${className}`}
>
  <Picture
    src={images.headshot.src}
    alt={images.headshot.alt}
    width={hero ? 280 : 140}
    widths={hero ? [280, 560, 840] : [140, 280, 420]}
    sizes={hero ? '(min-width: 360px) 280px, calc(100vw - 80px)' : '140px'}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    class={`aspect-[4/5] rounded-2xl bg-accent-soft object-cover ${hero ? 'w-full max-w-[280px]' : 'w-[140px]'}`}
  />
  <div class="min-w-0 space-y-1.5">
    <Heading class="text-[1.35rem] font-extrabold">{doctor.name}</Heading>
    <p class="font-bold text-primary">{doctor.title}</p>
    <p>{doctor.focus}. Has ADHD himself.</p>
    <p class="text-[0.9rem] text-ink-muted">Ahpra registration {doctor.ahpra}</p>
    {showBio && <p class="pt-2">{doctor.bioShort}</p>}
    {
      showLink && (
        <p class="pt-1">
          <a href="/about" class="inline-flex min-h-11 items-center gap-1.5 font-bold">
            About Dr Sam
            <Icon name="arrow-right" size={20} />
          </a>
        </p>
      )
    }
  </div>
</div>
