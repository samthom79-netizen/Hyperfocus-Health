---
/**
 * One price, clearly labelled, with what it includes.
 * Prices come from src/config/site.ts; a TODO price shows as a [TODO] box.
 * Rule: no hidden fees, so anything extra goes in `note` on the same card.
 * `note` may use {tokens} for site values.
 */
import Icon from './Icon.astro';
import Button from './Button.astro';
import { formatPrice, isTodo } from '../config/site';
import { renderTokens } from '../lib/tokens';

interface Props {
  title: string;
  price: number | string;
  /** e.g. 'total to diagnosis', 'per review' */
  priceLabel: string;
  includes: string[];
  note?: string;
  badge?: string;
  featured?: boolean;
  cta?: { label: string; href: string };
  class?: string;
}

const { title, price, priceLabel, includes, note, badge, featured = false, cta, class: className = '' } = Astro.props;
const shown = formatPrice(price);
---

<div
  class={`relative flex flex-col rounded-card bg-surface p-5 sm:p-6 ${featured ? 'border-2 border-primary' : 'border border-line'} ${className}`}
>
  {
    badge && (
      <span class="absolute -top-3 left-5 rounded-full bg-highlight px-3 py-0.5 text-[0.85rem] font-bold text-primary">
        {badge}
      </span>
    )
  }
  <h3 class="text-[1.15rem] font-bold">{title}</h3>
  <p class="mt-3 flex flex-wrap items-baseline gap-x-2">
    {
      isTodo(price) ? (
        <span class="todo text-[1.4rem]">[{shown}]</span>
      ) : (
        <span class="font-display text-[2.2rem] leading-none font-extrabold text-primary">{shown}</span>
      )
    }
    <span class="text-ink-muted">{priceLabel}</span>
  </p>
  <ul class="mt-4 space-y-2">
    {
      includes.map((item) => (
        <li class="flex gap-2">
          <Icon name="check" size={22} class="mt-0.5 text-accent-ink" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
  {note && <p class="mt-4 text-[0.92rem] text-ink-muted" set:html={renderTokens(note)} />}
  <slot />
  {
    cta && (
      <div class="mt-5 pt-1">
        <Button href={cta.href} variant={featured ? 'primary' : 'secondary'} full>
          {cta.label}
        </Button>
      </div>
    )
  }
</div>
