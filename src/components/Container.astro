---
/** Page-width wrapper: 16px side gutter on phones, max ~1150px on desktop. */
interface Props {
  class?: string;
  as?: 'div' | 'section' | 'header' | 'footer';
  id?: string;
  'aria-labelledby'?: string;
}

const { class: className = '', as: Tag = 'div', ...rest } = Astro.props;
---

<Tag class={`mx-auto w-full max-w-6xl px-4 sm:px-6 ${className}`} {...rest}>
  <slot />
</Tag>
